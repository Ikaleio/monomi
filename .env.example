# Host port exposed by Docker Compose on 127.0.0.1.
MONOMI_PORT=3000

# password (default) or none for a trusted private network.
MONOMI_AUTH_MODE=password

# Set true only when Monomi is served through HTTPS.
MONOMI_SECURE_COOKIE=false

# Concurrent monitor checks in this single instance.
MONOMI_CHECK_CONCURRENCY=10

# Optional. When blank, Monomi persists a generated secret under /data.
MONOMI_SESSION_SECRET=
